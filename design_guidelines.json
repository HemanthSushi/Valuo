    "shape": {
      "radius": "5px",
      "border": "1px solid #E7E5E4",
      "shadow": "none"
    },
    "machine_learning_core": {
      "models": ["RandomForest", "XGBoost"],
      "banned_models": ["LinearRegression", "LightGBM"]
    }
