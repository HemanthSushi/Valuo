{
  "identity": {
    "product_name": "Valuo",
    "persona": "Editorial Real Estate & Machine Learning Intelligence",
    "philosophy": "Precision, Quiet Authority, Empirical Data First.",
    "anti_patterns": [
      "Gradient text",
      "Glassmorphism or backdrop blur",
      "Glowing or colored soft shadows",
      "Emojis in the UI",
      "Sparkle or wand icons",
      "Pill-shaped buttons",
      "Nested cards",
      "Centered-everything layouts",
      "Generic marketing fluff ('Unlock the power of...')",
      "Three-icon floating grids",
      "Purple or blue gradients"
    ]
  },
  "design_system": {
    "theme": "Editorial Minimalist",
    "description": "High-contrast editorial typography, 1px hairline borders, and restrained terracotta accent for model benchmarking.",
    "colors": {
      "primary": "#1C1917",
      "primary_foreground": "#FAFAF9",
      "secondary": "#F0EFEB",
      "secondary_foreground": "#1C1917",
      "accent": "#C25E3E",
      "accent_foreground": "#FFFFFF",
      "background": "#FAFAF9",
      "foreground": "#1C1917",
      "muted": "#F0EFEB",
      "muted_foreground": "#78716C",
      "border": "#E7E5E4",
      "input": "#E7E5E4",
      "ring": "#C25E3E",
      "chart_1": "#C25E3E",
      "chart_2": "#3F3F46",
      "chart_3": "#71717A",
      "chart_4": "#A1A1AA",
      "chart_5": "#D4D4D8"
    },
    "typography": {
      "headings": {
        "family": "IBM Plex Sans, sans-serif",
        "weights": ["500", "600"],
        "usage": "H1-H6 headers, tight letter spacing (-0.02em)."
      },
      "body": {
        "family": "IBM Plex Sans, sans-serif",
        "weights": ["400", "500"],
        "usage": "Data labels, body copy, form inputs."
      },
      "mono": {
        "family": "JetBrains Mono, monospace",
