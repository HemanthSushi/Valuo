# Valuo Backend Environment Configuration
SQLITE_DB_PATH=workspace/valuo.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cryptographically Secure JWT Secret Key (REQUIRED: server fails to start if unset)
# Generate a new random secret using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_with_your_cryptographically_secure_secret_key
JWT_EXPIRES_MINUTES=1440

# Cryptographic HMAC-SHA256 Model Signing Key (defaults to JWT_SECRET if unset)
ARTIFACT_SIGNING_KEY=optional_dedicated_cryptographic_signing_key
